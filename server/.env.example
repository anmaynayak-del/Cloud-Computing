# Database: Transaction Pooler connection string (Port 6543)
DATABASE_URL="postgresql://user:password@host.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL: Session Pooler / Direct connection for migrations (Port 5432)
DIRECT_URL="postgresql://user:password@host.pooler.supabase.com:5432/postgres"

# JWT Secret for session tokens (generate any random string)
JWT_SECRET="generate-a-secure-random-secret-key"

# Gemini API Key (optional for AI insights & advisor)
GEMINI_API_KEY=""

# Allowed frontend origin (e.g. https://your-client-project.vercel.app or http://localhost:5173)
CLIENT_ORIGIN="http://localhost:5173"
